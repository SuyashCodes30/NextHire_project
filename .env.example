# ==============================================================================
# NextHire Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' (do NOT commit your real '.env' file)
# 2. Supply your local credentials and secrets
# ==============================================================================

# Database Configuration (MySQL)
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE

# Server Port (optional, default: 8080)
SERVER_PORT=8080

# JWT Authentication Secret (for future JWT implementation)
# Must be at least 256 bits (32+ characters) long
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_KEY_HERE
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# ==============================================================================
# Frontend Environment Configuration (for Vercel deployment)
# ==============================================================================
# In Vercel Project Settings -> Environment Variables:
# Set this to your deployed Spring Boot backend URL (e.g. https://your-backend.up.railway.app)
# For local development, leave unset or http://localhost:8080
VITE_API_BASE_URL=
