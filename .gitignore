# ==============================================================================
# NextHire — Git Ignore Configuration
# Protects sensitive credentials, local environment files, IDE state, and build outputs
# ==============================================================================

# 1. Environment & Local Secret Files (NEVER COMMIT REAL SECRETS)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Local Spring Boot properties / profiles with sensitive overrides
application-local.properties
application-local.yml
application-dev.properties
application-dev.yml
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-local.yml

# 3. Cryptographic Keys, Certificates & Tokens
*.pem
*.key
*.p12
*.jks
*.pfx
*.cer
*.crt
id_rsa
id_rsa.pub

# 4. Logs and diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Build outputs & Compiled artifacts
target/
backend/target/
*.class
*.jar
*.war
*.ear

# 6. Local Tooling & Bundled distributions
apache-maven-*/
maven/

# 7. IDE, Editor & OS metadata
.idea/
*.iml
.vscode/
.project
.classpath
.settings/
.DS_Store
Thumbs.db
ehthumbs.db

# 8. Python Cache
__pycache__/
*.py[cod]
*$py.class
